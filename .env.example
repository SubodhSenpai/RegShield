# RegShield settings. Only the optional LLM judge (--llm-judge / use_llm_judge=True) needs any.
#
# RegShield reads these from the environment; it does not load .env files itself.
# Export them in your shell or CI secrets, or load this file with a tool such as
# `dotenv run -- regshield eval scenarios.json --llm-judge`.

# Judge API key. OPENROUTER_API_KEY is sent to OpenRouter; OPENAI_API_KEY alone is sent to OpenAI.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional: judge model (default: a free OpenRouter model, or gpt-4.1-mini with an OpenAI key)
# JUDGE_MODEL=

# Optional: judge endpoint, for any OpenAI-compatible API
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1        # e.g. a local Ollama server

# Optional: log level for everything RegShield does (debug, info or warning)
# REGSHIELD_LOG=debug
