# ─────────────────────────────────────────────────────────
# RegressionShield — Environment Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────

# OpenRouter API credentials (required for live LLM-as-a-Judge evaluation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai

# LLM Judge model (cost-effective model for scoring)
JUDGE_MODEL=google/gemma-3-12b-it:free

# Demo mode — set to 'true' to use deterministic mock scores (no API needed)
DEMO_MODE=false

# Quality thresholds (adjust based on your application's requirements)
MIN_FAITHFULNESS_SCORE=0.80
MIN_RELEVANCY_SCORE=0.85
MIN_KEYWORD_COVERAGE_SCORE=0.60
MAX_ALLOWED_REDUNDANT_STEPS=1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
